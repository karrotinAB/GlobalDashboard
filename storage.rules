rules_version = '2';
// 클레임 파일 저장소: 대시보드 사용자(roles 문서가 있는 사람)만 올리고 볼 수 있음. 파일 하나 20MB 까지
service firebase.storage {
  match /b/{bucket}/o {
    function isTeam() {
      return request.auth != null && request.auth.token.email != null
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.token.email.lower())).data.level in ['admin', 'member', 'lead', 'director', 'auditor'];
    }
    function isAny() {
      return request.auth != null && request.auth.token.email != null
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.token.email.lower())).data.level in ['admin', 'member', 'trade', 'lead', 'director', 'auditor'];
    }
    // IT 검토용 계정: 파일은 보기 · 올리기만 (지우기 안 됨)
    function notAuditor() {
      return firestore.get(/databases/(default)/documents/roles/$(request.auth.token.email.lower())).data.level != 'auditor';
    }
    // 무역사무 요청 사진
    match /requests/{reqId}/{file} {
      allow read: if isAny();
      allow delete: if isAny() && notAuditor();
      allow create: if isAny() && request.resource.size < 20 * 1024 * 1024;
    }
    // 출고 관리 단계별 파일 (무역사무가 올리고 조원도 봄)
    match /ship/{folder}/{file} {
      allow read: if isAny();
      allow delete: if isAny() && notAuditor();
      allow create: if isAny() && request.resource.size < 20 * 1024 * 1024;
    }
    // 보고방 사진·파일 (조원 · 팀장님 · 이사님 · 관리자)
    match /reports/{reportId}/{file} {
      allow read: if isAny();
      allow delete: if isAny() && notAuditor();
      allow create: if isAny() && request.resource.size < 20 * 1024 * 1024;
    }
    // 계약서 원본 (관리자만)
    match /contracts/{id}/{file} {
      allow read: if request.auth != null && request.auth.token.email != null
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.token.email.lower())).data.level in ['admin', 'auditor', 'trade'];
      allow delete: if request.auth != null && request.auth.token.email != null
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.token.email.lower())).data.level in ['admin', 'trade'];
      allow create: if request.auth != null && request.auth.token.email != null
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.token.email.lower())).data.level in ['admin', 'trade']
        && request.resource.size < 50 * 1024 * 1024;
    }
    // 전도금 영수증: 올린 사람 폴더에만 올림 (읽기는 대시보드 사용자)
    match /petty/{email}/{file} {
      allow read: if isAny();
      allow create: if isAny() && request.auth.token.email.lower() == email && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAny() && notAuditor() && request.auth.token.email.lower() == email;
    }
    match /claims/{claimId}/{file} {
      allow read: if isTeam();
      allow delete: if isTeam() && notAuditor();
      allow create: if isTeam() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
