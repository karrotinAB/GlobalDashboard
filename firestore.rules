rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 우리 조 이메일만 읽고 쓸 수 있음 (반드시 소문자로)
    // 사람이 바뀌면 이 목록을 고치고 Firebase 콘솔 > Firestore > 규칙 에 붙여넣고 '게시'
    function isTeam() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'member1@example.com',
          'member2@example.com',
          'member3@example.com'
        ];
    }

    match /{col}/{id} {
      allow read, write: if isTeam()
        && col in ['members', 'companies', 'tasks', 'orders', 'attendance'];
    }
  }
}
