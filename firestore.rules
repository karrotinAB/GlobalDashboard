rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 접근 권한: access/{이메일(소문자)} 문서의 role
    //   admin  = 관리자 (설정 > 접근 권한에서 사람 추가·삭제)
    //   member = 조원 (대시보드 읽기·쓰기)
    // 문서가 없는 계정은 아무것도 못 봄. 이메일 인증을 마친 계정만 인정
    // 이메일 목록은 여기 적지 않음 → 사람이 바뀌어도 이 규칙은 그대로
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function role() {
      let p = /databases/$(database)/documents/access/$(myEmail());
      return exists(p) ? get(p).data.role : 'none';
    }
    function isTeam() { return signedIn() && role() in ['admin', 'member']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    match /access/{email} {
      // 내 권한은 나도 볼 수 있어야 '권한 없음' 화면을 띄움
      allow read: if signedIn() && (email == myEmail() || isTeam());
      // 관리자만 추가·변경·삭제. 내 권한은 내가 못 바꿈 (실수로 관리자가 0명 되는 것 방지)
      allow create, update: if isAdmin() && email != myEmail()
        && email == email.lower()
        && request.resource.data.role in ['admin', 'member']
        && request.resource.data.keys().hasOnly(['role', 'name', 'addedBy', 'addedAt']);
      allow delete: if isAdmin() && email != myEmail();
    }

    match /{col}/{id} {
      allow read, write: if isTeam()
        && col in ['members', 'companies', 'tasks', 'orders', 'attendance'];
    }
  }
}
