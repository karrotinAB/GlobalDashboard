rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 접근 권한: roles/{이메일(소문자)} 문서
    //   level: admin  = 관리자 (모든 조·무역사무 보기, 설정 > 대시보드 사용자에서 사람 추가·삭제)
    //          member = 조원 (자기 조 대시보드 읽기·쓰기)
    //          trade  = 무역사무 (무역사무 페이지: 요청·무역사무 담당자, 각 조 담당자 이름은 읽기만)
    //          lead / director = 팀장님 / 이사님 (자기만 쓰는 개인 대시보드 + 1~3조 데이터 읽기)
    //   team : '1' | '2' | '3' (조원·관리자의 조, 없으면 2조)
    //   space: 'p' + 영문·숫자 (팀장님·이사님의 개인 대시보드 공간, 관리자가 권한을 줄 때 만들어짐)
    // 문서가 없는 계정은 아무것도 못 봄 (계정은 관리자가 만들어 줌)
    //
    // 조마다 데이터가 따로: 2조 = members, companies … / 1조 = t1_members, t1_companies … / 3조 = t3_…
    // 개인 대시보드: p1a2b3c4_members, p1a2b3c4_tasks …
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function roleDoc() { return /databases/$(database)/documents/roles/$(myEmail()); }
    function role() {
      return exists(roleDoc()) ? get(roleDoc()).data.get('level', 'none') : 'none';
    }
    function myTeam() {
      return exists(roleDoc()) ? get(roleDoc()).data.get('team', '2') : 'none';
    }
    function mySpace() {
      return exists(roleDoc()) ? get(roleDoc()).data.get('space', '') : '';
    }
    function isLeader() { return signedIn() && role() in ['lead', 'director']; }
    function isTeam() { return signedIn() && role() in ['admin', 'member']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isTrade() { return signedIn() && role() == 'trade'; }
    function isAny() { return signedIn() && role() in ['admin', 'member', 'trade', 'lead', 'director']; }

    // 컬렉션 이름 → 조 / 원래 이름
    function prefixed(col) { return col.matches('[tp][a-z0-9]+_.+'); }
    function teamTag(col) { return prefixed(col) ? col.split('_')[0] : 't2'; }
    function baseOf(col) { return prefixed(col) ? col.split('_')[1] : col; }
    function teamCol(col) {
      return baseOf(col) in ['members', 'companies', 'tasks', 'orders', 'attendance', 'claims', 'config'];
    }
    // 이 공간 데이터를 쓸 수 있나: 관리자는 모두, 조원은 자기 조, 팀장님·이사님은 자기 개인 공간
    function inTeam(col) {
      return isAdmin()
        || (signedIn() && role() == 'member' && teamTag(col) == 't' + myTeam())
        || (isLeader() && mySpace() != '' && teamTag(col) == mySpace());
    }
    // 팀장님·이사님은 1~3조 데이터를 읽을 수 있음 ('조 현황')
    function leaderCanRead(col) { return isLeader() && teamTag(col).matches('t[0-9]+'); }
    // 이 공간의 관리자: 관리자, 또는 자기 개인 공간의 팀장님·이사님
    function ownsSpace(col) { return isAdmin() || (isLeader() && mySpace() != '' && teamTag(col) == mySpace()); }

    match /roles/{email} {
      // 내 권한은 나도 볼 수 있어야 '권한 없음' 화면을 띄움
      allow read: if signedIn() && (email == myEmail() || isTeam());
      // 관리자만 추가·변경·삭제. 내 권한은 내가 못 바꿈 (실수로 관리자가 0명 되는 것 방지)
      allow create, update: if isAdmin() && email != myEmail()
        && email == email.lower()
        && request.resource.data.level in ['admin', 'member', 'trade', 'lead', 'director']
        && request.resource.data.get('team', '2') in ['1', '2', '3']
        && (request.resource.data.get('space', '') == '' || request.resource.data.get('space', '').matches('p[a-z0-9]+'))
        && request.resource.data.keys().hasOnly(['level', 'name', 'team', 'space', 'addedBy', 'addedAt']);
      allow delete: if isAdmin() && email != myEmail();
    }

    // 지금 보고 있는 페이지 (탭 오른쪽 위 동그라미): 모두 읽고, 자기 것만 씀
    match /presence/{email} {
      allow read: if isAny();
      allow write: if isAny() && email == myEmail();
    }

    // 무역사무 요청 (모든 조 + 무역사무): 지우기는 관리자와 그 요청을 한 사람만 — 보통은 '취소'로 기록을 남김
    match /requests/{id} {
      allow read, create, update: if isAny();
      allow delete: if isAdmin() || (isAny() && (resource.data.get('requesterEmail', '') == myEmail() || resource.data.get('createdByEmail', '') == myEmail()));
    }

    // 무역사무 담당자 카드: 모두 읽고, 무역사무·관리자가 추가/수정
    //   말풍선(status)·캐릭터(character)는 카드 주인(email)만, 주인 이메일은 관리자 또는 '이 카드가 나예요'
    match /tradeMembers/{id} {
      allow read: if isAny();
      allow create, delete: if isAdmin() || isTrade();
      allow update: if (isAdmin() || isTrade())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'character'])
            || resource.data.get('email', '') == myEmail())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || isAdmin()
            || (resource.data.get('email', '') == '' && request.resource.data.get('email', '') == myEmail()));
    }

    // 공용 mem 이름 목록 / 공용 근태함: 한 사람이 mem 을 연동하면 모든 조·팀장님·이사님·무역사무 근태가 같이 들어옴
    match /memDirectory/{space} {
      allow read, write: if isAny();
    }
    match /memAttendance/{id} {
      allow read, write: if isAny();
    }

    // 판매 데이터 (서버 함수가 매일 아침 씀): 모두 읽기만
    match /salesMonthly/{id} {
      allow read: if isAny();
    }
    match /storeBranches/{code} {
      allow read: if isAny();
    }
    match /fxRates/{id} {
      allow read: if isAny();
    }
    match /exportMonthly/{id} {
      allow read: if isAny();
    }
    match /exportSync/{id} {
      allow read: if isAny();
    }
    match /salesBackfill/{id} {
      allow read: if isAny();
    }
    match /salesStatus/{id} {
      allow read: if isAny();
    }

    // 내 달력 (iCal 주소): 본인만 읽고 씀 — 달력 페이지에서 본인에게만 보임
    match /userCalendars/{email} {
      allow read, write: if isAny() && email == myEmail();
    }

    // secrets/{문서} (ERP API 키 등): 규칙이 없으므로 사이트에서는 아무도 못 읽고 못 씀. 서버 함수만 읽음

    // 조 데이터 (members, companies, tasks, orders, attendance, claims, config 와 t1_… t3_…)
    match /{col}/{id} {
      allow read: if teamCol(col)
        && (inTeam(col)
            || leaderCanRead(col)
            // 무역사무: 각 조 담당자 이름(요청자) + 무역사무 근태(2조 쪽 attendance)
            || (isTrade() && (baseOf(col) == 'members' || col == 'attendance'))
            // 무역사무: 요청에 연결된 주문 보기 (각 조 주문·업체 읽기만)
            || (isTrade() && baseOf(col) in ['orders', 'companies']));

      // 공용 설정(홈 화면 구성 등)은 관리자만 (개인 대시보드는 그 주인도)
      allow write: if teamCol(col) && baseOf(col) == 'config' && ownsSpace(col);

      allow create, delete: if teamCol(col) && baseOf(col) != 'config'
        && (inTeam(col) || (isTrade() && col == 'attendance'));

      // 담당자 카드: 말풍선(status)·시계(clocks)는 카드 주인(email)만, 캐릭터는 주인 또는 관리자
      // 카드 주인 이메일: 관리자는 언제나, 본인은 '주인 없는 카드'를 자기 이메일로 연결할 때만 ("이 카드가 나예요")
      allow update: if teamCol(col) && baseOf(col) != 'config'
        && (inTeam(col) || (isTrade() && col == 'attendance'))
        && (baseOf(col) != 'members'
            || ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'clocks'])
                 || resource.data.get('email', '') == myEmail())
                // 캐릭터는 카드 주인 또는 이 공간 관리자(관리자·자기 공간의 팀장님·이사님)
                && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['character'])
                    || resource.data.get('email', '') == myEmail()
                    || ownsSpace(col))
                && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
                    || ownsSpace(col)
                    || (resource.data.get('email', '') == '' && request.resource.data.get('email', '') == myEmail()))));
    }
  }
}
