rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 접근 권한: roles/{이메일(소문자)} 문서의 level (Global Opening Prep 과 같은 구조)
    //   admin  = 관리자 (설정 > 접근 권한에서 사람 추가·삭제)
    //   member = 조원 (대시보드 읽기·쓰기)
    //   trade  = 무역사무 (무역사무 페이지: 요청·무역사무 담당자만. 2조 담당자 이름은 읽기만)
    // 문서가 없는 계정은 아무것도 못 봄 (계정은 관리자가 설정 > 접근 권한에서 만들어 줌)
    // 이메일 목록은 여기 적지 않음 → 사람이 바뀌어도 이 규칙은 그대로
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function role() {
      let p = /databases/$(database)/documents/roles/$(myEmail());
      return exists(p) ? get(p).data.get('level', 'none') : 'none';
    }
    function isTeam() { return signedIn() && role() in ['admin', 'member']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isTrade() { return signedIn() && role() == 'trade'; }
    function isAny() { return signedIn() && role() in ['admin', 'member', 'trade']; }

    match /roles/{email} {
      // 내 권한은 나도 볼 수 있어야 '권한 없음' 화면을 띄움
      allow read: if signedIn() && (email == myEmail() || isTeam());
      // 관리자만 추가·변경·삭제. 내 권한은 내가 못 바꿈 (실수로 관리자가 0명 되는 것 방지)
      allow create, update: if isAdmin() && email != myEmail()
        && email == email.lower()
        && request.resource.data.level in ['admin', 'member', 'trade']
        && request.resource.data.keys().hasOnly(['level', 'name', 'addedBy', 'addedAt']);
      allow delete: if isAdmin() && email != myEmail();
    }

    // 담당자 카드: 말풍선(status)·캐릭터(character)는 카드 주인(email)만 바꿈
    // 카드 주인 이메일: 관리자는 언제나, 본인은 '주인 없는 카드'를 자기 이메일로 연결할 때만 ("이 카드가 나예요")
    match /members/{id} {
      allow read: if isAny(); // 무역사무도 요청자 이름을 봐야 해서 읽기만
      allow create, delete: if isTeam();
      allow update: if isTeam()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'character'])
            || resource.data.get('email', '') == myEmail())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || isAdmin()
            || (resource.data.get('email', '') == '' && request.resource.data.get('email', '') == myEmail()));
    }

    // 지금 보고 있는 페이지 (탭 오른쪽 위 동그라미): 모두 읽고, 자기 것만 씀
    match /presence/{email} {
      allow read: if isAny();
      allow write: if isAny() && email == myEmail();
    }

    // 무역사무 요청: 2조·무역사무 모두 읽고 쓰기 (지우기는 관리자만 — 보통은 '취소'로 기록을 남김)
    match /requests/{id} {
      allow read, create, update: if isAny();
      allow delete: if isAdmin();
    }

    // 무역사무 담당자 카드: 모두 읽고, 무역사무·관리자가 추가/수정
    //   말풍선(status)·캐릭터(character)는 카드 주인(email)만, 주인 이메일은 관리자 또는 '이 카드가 나예요'
    match /tradeMembers/{id} {
      allow read: if isAny();
      allow create, delete: if isAdmin() || isTrade();
      allow update: if (isAdmin() || isTrade())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'character'])
            || resource.data.get('email', '') == myEmail())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || isAdmin()
            || (resource.data.get('email', '') == '' && request.resource.data.get('email', '') == myEmail()));
    }

    // secrets/{문서} (ERP API 키 등): 규칙이 없으므로 사이트에서는 아무도 못 읽고 못 씀. 서버 함수만 읽음

    // 팀 공용 설정 (홈 화면 구성 등): 모두 읽고, 관리자만 바꿈
    match /config/{id} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    match /{col}/{id} {
      allow read, write: if isTeam()
        && col in ['companies', 'tasks', 'orders', 'attendance', 'claims'];
    }
  }
}
